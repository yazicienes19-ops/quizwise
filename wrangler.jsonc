{
	"name": "studearc",
	"compatibility_date": "2026-08-16",
	"main": "worker/index.js",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "studearc.com", "custom_domain": true },
		{ "pattern": "www.studearc.com", "custom_domain": true }
	]
}
